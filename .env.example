# ── Supabase (required) ───────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (required) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# ── OpenAI (optional — invoice analysis falls back gracefully) ────────────────
OPENAI_API_KEY=

# ── Google Cloud Vision (optional — OCR falls back to Textract) ───────────────
GOOGLE_APPLICATION_CREDENTIALS=

# ── AWS Textract (optional — OCR falls back to Google Vision) ────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-2

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_EMAILS=
